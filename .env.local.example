# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Claude / Anthropic ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Apple CalDAV (optional) ───────────────────────────────────
APPLE_ID=du@icloud.com
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_CALENDAR_URL=https://p##-caldav.icloud.com/.../
APPLE_REMINDERS_URL=https://p##-caldav.icloud.com/.../

# ── YouTube: Public Mode ──────────────────────────────────────
# PFLICHT – YouTube-Tab ohne OAuth (RSS-Feed + opt. Statistiken)
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL – Öffentliche Video-Statistiken (Views, Likes, Kommentare)
# Ohne diesen Key werden nur RSS-Daten angezeigt (Titel, Thumbnail, Datum)
# Kostenloses API-Key: console.cloud.google.com → YouTube Data API v3 → Credentials → API Key
YOUTUBE_API_KEY=AIzaSy...

# ── YouTube: Studio Mode (optional, für echte Analytics) ─────
# Nur nötig für CTR, Impressionen, Watchtime, Zuschauerbindung
# Ohne diese Keys läuft der YouTube-Tab automatisch im Public Mode
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# ── App URL ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
