# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── Claude / Anthropic ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Apple CalDAV ──────────────────────────────────────────────
APPLE_ID=you@icloud.com
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_CALENDAR_URL=https://p##-caldav.icloud.com/YOUR_ID/calendars/YOUR_CAL/
APPLE_REMINDERS_URL=https://p##-caldav.icloud.com/YOUR_ID/calendars/YOUR_REMINDERS/

# ── Google / YouTube ──────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Enable: "YouTube Data API v3" + "YouTube Analytics API"
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Must match exactly what's registered in Google Cloud Console:
# Dev: http://localhost:3000/api/youtube/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# ── App URL (for OAuth redirects) ─────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
